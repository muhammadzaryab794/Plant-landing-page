---
import img from '../assets/images/Group 1.png'
import icon1 from '../assets/images/Time-Cosuming.svg';
import icon2 from '../assets/images/Grow_Sprout.svg';
import icon3 from '../assets/images/Temperature.svg';
import icon4 from '../assets/images/Pruning.svg';
---

<section class="section-benifits">
  <div class=" padding-bottom-large">
    <div class="container-large">
      <div class="benifits_component">
        <div class="benifits_image-wrapper">
            <img src={img.src} alt="" class="benifits_image">
        </div>
        <div class="benifits_list-wrapper">
            <div class="benifits_item">
                <img src={icon1.src} alt="" class="benifits_item-image">
                <p class="benifits_item-name">Quality Product</p>
                <p class="benifits_item-text">Our flowers are of the highest quality, carefully selected and sourced from reputable</p>
            </div>  

            <div class="benifits_item is-gray">
                <img src={icon2.src} alt="" class="benifits_item-image">
                <p class="benifits_item-name">Always Fresh</p>
                <p class="benifits_item-text">Our flowers are always fresh, handpicked and delivered promptly for maximum longevity</p>
            </div>  

            <div class="benifits_item is-gray">
                <img src={icon3.src} alt="" class="benifits_item-image">
                <p class="benifits_item-name">Work Smart</p>
                <p class="benifits_item-text">We work smart, using innovative techniques and technology to streamline our processes</p>
            </div>  

            <div class="benifits_item ">
                <img src={icon1.src} alt="" class="benifits_item-image">
                <p class="benifits_item-name">Excellent Service</p>
                <p class="benifits_item-text">We pride ourselves on providing excellent service, going above to meet our customers' needs</p>
            </div>  
        </div>
      </div>
    </div>
  </div>
</section>
