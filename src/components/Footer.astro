---
import icon from '../assets/images/mdi_instagram.svg';
import icon2 from '../assets/images/uit_facebook-f.svg';
import icon3 from '../assets/images/tabler_brand-twitter.svg';

import bgImg from '../assets/images/Monstera 1.png';
import bgImg2 from '../assets/images/Fern 1.png';


---

<section class="section-footer">
  <div class="padding-global">
    <div class="container-large">
        <div class="footer_component">
            <div class="footer_content-wrapper">
                <h4 class="footer_heading">Feel free to contact us</h4>
                <div class = "footer_social-icon-wrapper">
                    <div class="footer_social-icon-wrapper">
                    <div class="footer_social-icon"><img src={icon.src} alt="" class="footer_social-image"></div>
                    <div class="footer_social-icon"><img src={icon2.src} alt="" class="footer_social-image"></div>
                    <div class="footer_social-icon"><img src={icon3.src} alt="" class="footer_social-image"></div>
                    </div>
                </div>

                 <div class="footer_page-links">
                   <a href="#" class="footer_link">Home</a>
                   <a href="#" class="footer_link">About Us</a>
                   <a href="#" class="footer_link">Plants</a>
                   <a href="#" class="footer_link">Delivery</a>
                   <a href="#" class="footer_link">Blog</a>
                   <a href="#" class="footer_link">Contact Us</a>
                </div>
            </div>  
            
            <div class="footer_bg-image-wrapper">
                <img src={bgImg.src} alt="" class="footer_bg1">
                <img src={bgImg2.src} alt="" class="footer_bg2">
            </div>
        </div>
    </div>
  </div>
</section>
<div class="footer_copyright-text-wrapper">
    <p class="footer_copyright-text">Copyright © 2021 Lush. All rights reserved.</p>
</div>