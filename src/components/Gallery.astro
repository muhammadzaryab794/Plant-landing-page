---
import img1 from '../assets/images/image 5.png';
import img2 from '../assets/images/pexels-cottonbro-studio-4507715 2.png';
import img3 from '../assets/images/pexels-cottonbro-studio-4507715 3.png';
import img4 from '../assets/images/pexels-cottonbro-studio-4507715 4.png';
import img5 from '../assets/images/pexels-cottonbro-studio-4507715 5.png';


---


<section class="section-gallery">
  <div class=" padding-bottom-large">
    <div class="container-large">
      <div class="gallery_component">
        
        <div class="section_heading-wrapper">
          <h2 class="section_heading h2">Our Gallery View</h2>
        </div>
        <div class="gallery_images-wrapper">
            <img src={img1.src} alt="" class="gallery_images">
            <img src={img2.src} alt="" class="gallery_images">
            <img src={img3.src} alt="" class="gallery_images">
            <img src={img4.src} alt="" class="gallery_images">
            <img src={img5.src} alt="" class="gallery_images">

        </div>
      </div>
    </div>
  </div>
</section>
