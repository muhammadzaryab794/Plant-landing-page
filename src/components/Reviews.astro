---
import img from '../assets/images/Rectangle.svg';
import img2 from '../assets/images/Rectangle (1).svg';
import img3 from '../assets/images/Rectangle (2).svg';


import bgImg from '../assets/images/Zz_Plant 1.png'
import bgImg2 from '../assets/images/Snake_Plant 1.png'
import bgImg3 from '../assets/images/Bamboo 258.png'

---

<section class="section-reviews">
  <div class="padding-global padding-bottom-large">
    <div class="container-large">
      <div class="reviews_component">
        
        <div class="section_heading-wrapper">
          <h2 class="section_heading h2">What Do They Say About Us</h2>
        </div>

        <div class="reviews_card-wrapper">
            <div class="reviews_card">
                <div class="reviews_header">
                <img src={img.src} alt="" class="reviews_image">
                <h3 class="reviews_heading">Jessica Watson</h3></div>
                <p class="reviews_text">“ Highly recommend this website for quality flowers and plants. Great prices, timely delivery and excellent customer service. ”</p>
                <img src={bgImg.src} alt="" class="reviews_bg-image">
            </div>
        

        
            <div class="reviews_card">
                <div class="reviews_header">
                <img src={img2.src} alt="" class="reviews_image">
                <h3 class="reviews_heading">Kate Szu</h3></div>
                <p class="reviews_text">“ Highly recommend this website for quality flowers and plants. Great prices, timely delivery and excellent customer service. ”</p>
                <img src={bgImg2.src} alt="" class="reviews_bg-image">
            </div>
        

         
            <div class="reviews_card">
                <div class="reviews_header">
                <img src={img3.src} alt="" class="reviews_image">
                <h3 class="reviews_heading">Grace </h3></div>
                <p class="reviews_text">“ Highly recommend this website for quality flowers and plants. Great prices, timely delivery and excellent customer service. ”</p>
                <img src={bgImg3.src} alt="" class="reviews_bg-image">
            </div>
        </div>

      </div>
    </div>
  </div>
</section>