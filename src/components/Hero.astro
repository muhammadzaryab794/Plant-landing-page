---
import image from '../assets/images/material-symbols_play-circle-outline-rounded.svg';
---
<section class="section-hero">
 <div class="padding-global padding-top-large padding-medium">
    <div class="container-large">
        <div class="hero_component">
            <div class="hero_content-wrapper ">
                <h1 class="hero_heading h1">
                    Nature's Beauty Delivered to You
                </h1>
                <p class="hero_paragraph text-medium">Nature's beauty is just a click away with our online flower and plant shop. We offer a wide variety of flowers that will bring a touch of nature to your home!</p>
            </div>
            <div class="hero_buttons-wrapper">
                <a href="#" class="hero_button-1 primary_button">Book Now</a>
                <a href="#" class="hero_button-2 secondary_button"><img src={image.src} alt="" class="button_icon" width="20px" height="20px">Watch Video</a>
            </div>
            
        </div>
    </div>
 </div>
</section>