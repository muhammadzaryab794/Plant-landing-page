---
import img1 from '../assets/images/bg_image.png';
---

<section class="section-cta">
    <img src={img1.src} alt="" class="cta_bg-image">
    <div class="padding-global padding-bottom-large">
        <div class="container-large">
        <div class="cta_component">
           <h2 class = "cta_heading">
            Enter Your Email Address For Our Mailing Promo Or Other Interesting Things
           </h2>
           <form class="cta_contact-form">
            <input type = "email" name="email" placeholder="Enter Your Mail" required />
            <a href="#" class="cta_buttom primary_button">Submit</a>
           </form>

        </div>
        </div>
    </div>

</section>
