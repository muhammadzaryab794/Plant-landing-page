---
import img1 from '../assets/images/image 6.png';
import img2 from '../assets/images/image 7.png';
import img3 from '../assets/images/image 8.png';

import iconArrow from '../assets/images/material-symbols_arrow-right-alt.svg';
import iconDate from '../assets/images/date_icon.svg';

---

<section class="section-blog">
    <div class="padding-global padding-bottom-large">
        <div class="container-large">
            <div class="blog_component">
              <div class="section_heading-wrapper">
                <h2 class="section_heading h2">Interesting Blog To Read</h2>
                 </div>

                 <div class="blog_card-wrapper">
                    <div class="blog_card">
                        <div class="blog_card-image-wrapper">
                          <img src={img1.src} alt="" class="blog_card-image">
                        </div>
                            <div class="blog_content">
                                <p class="blog_content-heading ">More productive with an atmosphere of greenery </p>
                                <p class="blog_content-text">An atmosphere of greenery can increase productivity in the workplace. Studies show that plants improve air quality and decrease stress...</p>
                            <div class="blog_bottom-content">
                                <div class="blog_date-wrapper">
                                    <img src={iconDate.src} alt="" class="blog_date-icon">
                                    <p class="blog_date">January 20, 2023</p>
                                </div>
                                <div class="blog_read-icon-wrapper">
                                    <p class="blog_read-text">Read More</p>
                                    <img src={iconArrow.src} alt="" class="blog_read-icon">
                                </div>
                            </div>
                            </div>
                        
                    </div>

                    <div class="blog_card">
                        <div class="blog_card-image-wrapper">
                          <img src={img2.src} alt="" class="blog_card-image">
                        </div>
                            <div class="blog_content">
                                <p class="blog_content-heading ">The benefits of plants in your room </p>
                                <p class="blog_content-text">Plants in your room can bring numerous benefits, such as improved air quality, reduced stress, and increased feelings of well-being....</p>
                            <div class="blog_bottom-content">
                                <div class="blog_date-wrapper">
                                    <img src={iconDate.src} alt="" class="blog_date-icon">
                                    <p class="blog_date">January 10, 2023</p>
                                </div>
                                <div class="blog_read-icon-wrapper">
                                    <p class="blog_read-text">Read More</p>
                                    <img src={iconArrow.src} alt="" class="blog_read-icon">
                                </div>
                            </div>
                            </div>
                        
                    </div>

                    <div class="blog_card">
                        <div class="blog_card-image-wrapper">
                          <img src={img3.src} alt="" class="blog_card-image">
                        </div>
                            <div class="blog_content">
                                <p class="blog_content-heading ">Hobbyist plants in the house </p>
                                <p class="blog_content-text">Having hobbyist plants in the house is a great way to bring nature indoors. Not only do they purify the air, but they....</p>
                            <div class="blog_bottom-content">
                                <div class="blog_date-wrapper">
                                    <img src={iconDate.src} alt="" class="blog_date-icon">
                                    <p class="blog_date">January 15, 2023</p>
                                </div>
                                <div class="blog_read-icon-wrapper">
                                    <p class="blog_read-text">Read More</p>
                                    <img src={iconArrow.src} alt="" class="blog_read-icon">
                                </div>
                            </div>
                            </div>
                        
                    </div>


                 </div>
            </div>
        </div>
    </div>
</section>